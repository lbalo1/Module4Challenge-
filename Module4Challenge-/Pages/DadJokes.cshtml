@page
@model Module4Challenge.Pages.DadJokesModel
@{
    ViewData["Title"] = "Dad Joke Generator";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-4">Dad Joke Generator</h1>
        <p class="lead text-muted">Get ready to groan! Here are some of the best dad jokes around.</p>
    </div>

    <div class="row">
        @foreach (var joke in Model.CurrentJokes)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-primary">😄 Dad Joke</h5>
                        <p class="card-text">@joke</p>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="text-center mt-5 mb-5">
        <form method="post">
            <button type="submit" class="btn btn-primary btn-lg">
                Get More Jokes
            </button>
        </form>
    </div>
</div>